APP_NAME="SkillUp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://skillup.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skillup
DB_USERNAME=skillup
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.skillup.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_WORKERS=2
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT=120
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=public
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30

MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@skillup.example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=

ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@skillup.example.com
ZEPTOMAIL_FROM_NAME="${APP_NAME}"
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com/v1.1

SES_FROM_ADDRESS=noreply@skillup.example.com
SES_FROM_NAME="${APP_NAME}"

WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_BASE_URL=https://graph.facebook.com

DISCOURSE_BASE_URL=https://community.skillup.example.com
DISCOURSE_SSO_SECRET=
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system

LEGACY_WORDPRESS_URL=https://learnlive.site
LEGACY_MOODLE_URL=https://portal.learnlive.site
SUPPORT_ALERT_EMAIL=support@skillup.example.com
